<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.DeleteAccountActivity">

    <RelativeLayout
        android:id="@+id/toolbarRl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/toolbar_bg02">

        <ImageButton
            android:id="@+id/toolbarBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_white"
            android:background="@android:color/transparent"
            android:paddingRight="10dp"
            android:adjustViewBounds="true"
            app:tint="?attr/colorOnPrimary" />


        <TextView
            android:id="@+id/toolbarTitleTv"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarBackBtn"
            android:text="Delete Account"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileIv"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:src="@drawable/person_black"
            android:scaleType="centerCrop"
            android:background="?attr/colorOnPrimary"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/toolbarTitleTv"
            android:layout_marginVertical="10dp"
            app:shapeAppearanceOverlay="@style/ImageStyle_Circle"/>

        <TextView
            android:id="@+id/toolbarDescriptionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:text="Are you sure want to delete your account including data? You will not able to access your account again! Thise action can't be undrone!"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:layout_below="@+id/profileIv"
            android:paddingHorizontal="10dp"/>


    </RelativeLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:minHeight="@dimen/m_toolbar_height"
        android:layout_margin="10dp"
        android:text="Confirm Delete"
        app:icon="@drawable/block_gray"/>

</RelativeLayout>