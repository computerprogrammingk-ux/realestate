<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    tools:context=".fragments.HomeFragment">

<RelativeLayout
    android:id="@+id/toolbarRl"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/toolbar_bg02">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:cardCornerRadius="20dp"
        app:contentPadding="5dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchEt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/search_gray"
                android:drawablePadding="5dp"
                android:hint="@string/search_hint"
                android:layout_weight="1"
                android:padding="8dp"
                android:textSize="12dp"/>


            <com.google.android.material.divider.MaterialDivider
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                app:dividerColor="@color/colorGray81"
                android:layout_marginHorizontal="8dp"/>
            <TextView
                android:id="@+id/cityTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:drawableEnd="@drawable/next_gray"
                android:layout_marginEnd="8dp"
                android:drawableTop="@color/colorPrimary"
                android:text="@string/choose_location"
                android:gravity="center_vertical"/>





        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp">

        <Spinner
            android:id="@+id/filterSelectedSp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:entries="@array/yemen_governorates"

            />


<!--        <TextView-->
<!--            android:id="@+id/filterTV"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/filter"-->
<!--            android:gravity="center_vertical"-->
<!--            android:drawableStart="@drawable/ic_sort_white"-->
<!--            android:drawableTint="@color/black"-->
<!--            android:drawablePadding="5dp"/>-->

    </LinearLayout>


    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="8dp"
        app:dividerThickness=".5dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/propertiesRv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/row_property"
        />


</LinearLayout>